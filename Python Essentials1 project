import random

board = [" " for _ in range(9)]

def print_board():
    print("\n")
    print(f" {board[0]} | {board[1]} | {board[2]} ")
    print("---+---+---")
    print(f" {board[3]} | {board[4]} | {board[5]} ")
    print("---+---+---")
    print(f" {board[6]} | {board[7]} | {board[8]} ")
    print("\n")

def print_positions():
    print("\n")
    print(" 1 | 2 | 3 ")
    print("---+---+---")
    print(" 4 | 5 | 6 ")
    print("---+---+---")
    print(" 7 | 8 | 9 ")
    print("\n")

def check_winner(symbol):
    wins = [
        [0,1,2], [3,4,5], [6,7,8],
        [0,3,6], [1,4,7], [2,5,8],
        [0,4,8], [2,4,6]
    ]
    return any(all(board[i] == symbol for i in combo) for combo in wins)

def board_full():
    return " " not in board

def player_move():
    while True:
        try:
            pos = int(input("Choose a position (1-9): ")) - 1

            if pos < 0 or pos > 8:
                print("Invalid position!")
                continue

            if board[pos] != " ":
                print("Position already taken!")
                continue

            board[pos] = "X"
            break

        except ValueError:
            print("Enter a valid number!")

def computer_move():
    # محاولة الربح
    for i in range(9):
        if board[i] == " ":
            board[i] = "O"
            if check_winner("O"):
                return
            board[i] = " "

    # منع اللاعب من الربح
    for i in range(9):
        if board[i] == " ":
            board[i] = "X"
            if check_winner("X"):
                board[i] = "O"
                return
            board[i] = " "

    # الوسط
    if board[4] == " ":
        board[4] = "O"
        return

    # الزوايا
    corners = [0, 2, 6, 8]
    free_corners = [i for i in corners if board[i] == " "]
    if free_corners:
        board[random.choice(free_corners)] = "O"
        return

    # أي مكان فارغ
    free = [i for i in range(9) if board[i] == " "]
    board[random.choice(free)] = "O"

def main():
    print("=" * 30)
    print(" TIC TAC TOE - Player vs AI ")
    print("=" * 30)

    print_positions()

    while True:
        print_board()

        player_move()

        if check_winner("X"):
            print_board()
            print("🎉 You Win!")
            break

        if board_full():
            print_board()
            print("🤝 Draw!")
            break

        print("🤖 AI is thinking...")
        computer_move()

        if check_winner("O"):
            print_board()
            print("💻 AI Wins!")
            break

        if board_full():
            print_board()
            print("🤝 Draw!")
            break

if __name__ == "__main__":
    main()
