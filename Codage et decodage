# برنامج تشفير وفك التشفير

def encrypt(text, shift):
    result = ""

    for char in text:
        if char.isalpha():
            if char.isupper():
                result += chr((ord(char) - ord('A') + shift) % 26 + ord('A'))
            else:
                result += chr((ord(char) - ord('a') + shift) % 26 + ord('a'))
        else:
            result += char

    return result


def decrypt(text, shift):
    return encrypt(text, -shift)


print("=" * 40)
print("🔐 برنامج التشفير وفك التشفير")
print("=" * 40)

while True:
    print("\n1 - تشفير")
    print("2 - فك التشفير")
    print("3 - خروج")

    choice = input("\nاختر: ")

    if choice == "1":
        text = input("أدخل النص: ")
        shift = int(input("أدخل مفتاح التشفير (رقم): "))
        encrypted = encrypt(text, shift)
        print("\n✅ النص المشفر:")
        print(encrypted)

    elif choice == "2":
        text = input("أدخل النص المشفر: ")
        shift = int(input("أدخل مفتاح التشفير: "))
        decrypted = decrypt(text, shift)
        print("\n✅ النص بعد فك التشفير:")
        print(decrypted)

    elif choice == "3":
        print("👋 إلى اللقاء")
        break

    else:
        print("❌ اختيار غير صحيح")
